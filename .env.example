# Copy to .env for local development. Guided practice works without a key.
GROQ_API_KEY=
# Optional legacy provider. Groq takes priority when configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
PORT=5173

# Optional learner accounts (Auth0 Regular Web Application)
APP_ORIGIN=http://localhost:5173
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Optional SpeakBuddy email/password accounts with signup OTP
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
